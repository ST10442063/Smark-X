{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedWebOrigins": [ "http://localhost:5090", "https://localhost:5091" ],
  "Gateway": {
    "BufferCapacity": 512,
    "RollingWindow": 40,
    "WarningZScore": 2.0,
    "CriticalZScore": 3.0,
    "MinimumSamplesBeforeScoring": 8,
    "UploadRoot": "App_Data/attachments",
    "MaxUploadBytes": 10485760,
    "AllowedUploadExtensions": [ ".log", ".txt", ".json", ".yaml", ".yml", ".csv", ".cfg", ".ini", ".png", ".jpg", ".jpeg" ],
    "SeedOnStartup": true,
    "SeedSensorCount": 14,
    "SeedReadingsPerSensor": 1440,
    "HistoryRetentionHours": 48
  },
  "Stream": {
    "SimulatedProcessingMs": 20,
    "StandardLaneCapacity": 10000,
    "CommandTimeoutSeconds": 30,
    "SweepIntervalSeconds": 5,
    "BroadcastIntervalMs": 500,
    "EventLogCapacity": 5000,
    "UndoDepth": 100,
    "PatternWindowMinutes": 10,
    "DismissMinutes": 30,
    "SeedOperatorHistory": true,
    "Bands": {
      "EnvironmentalFloorPercent": 20,
      "EnvironmentalRecoveryMargin": 5,
      "PowerCeilingWatts": 2500,
      "PowerSpikeRatio": 2.5,
      "LinkFloorDbm": -90
    },
    "Advisor": {
      "MinSupport": 2,
      "MinConfidence": 0.4,
      "MaxSuggestions": 6
    }
  }
}
